<% layout("/layouts/boilerplate.ejs") -%>
<!-- <body style="font-size: 20px;"> -->
    <h1>All Listings</h1>

    <!-- <form action="/listings/new" method="get">
        <button style="font-size: 22px;">Create New Listing</button>
    </form> -->

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <%for(list of allListings){%>
            <a href="/listings/<%=list._id%>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%=list.image%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%=list.title%></b> <br>
                            Price : &#8377; <%=list.price.toLocaleString("en-IN")%> /night  
                        </p>
                    </div>
                </div>
            </a>
        <%}%> 
    </div>
